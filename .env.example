# =========================================================================
# Arcane Environment Variables Template
# =========================================================================
# Instructions: Rename this file to ".env" and modify the values.
# IMPORTANT: Never upload the actual ".env" file to public Git repositories!

# --- Database Configuration ---
# Name of the PostgreSQL database
DB_NAME=arcane_db

# Username for database access
DB_USER=arcane_admin

# Secure password for the database (Please change before starting!)
DB_PASSWORD=A_Very_Secure_Password_123!


# --- Arcane Security ---
# Encryption key for sensitive data within Arcane.
# Generate on Linux/macOS using the command: openssl rand -hex 32
ARCANE_ENCRYPTION_KEY=generate_a_32_byte_hex_key_and_paste_it_here